<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <PawnKindDef Name="AnarchistBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>Anarchists</defaultFactionDef>
    <chemicalAddictionChance>0.20</chemicalAddictionChance>
    <invNutrition>3.00</invNutrition>
    <biocodeWeaponChance>0.9</biocodeWeaponChance>
    <techHediffsChance>0.05</techHediffsChance>
    <gearHealthRange>0.7~0.95</gearHealthRange>
    <initialResistanceRange>20~50</initialResistanceRange>
    <initialWillRange>8~15</initialWillRange>
  </PawnKindDef>
  <!-- ополченец -->
  <PawnKindDef ParentName="AnarchistBase">
    <defName>civil_gunner</defName>
    <label>Ополченец</label>
    <combatPower>40</combatPower>
    <itemQuality>Normal</itemQuality>
    <apparelMoney>220~400</apparelMoney>
    <apparelTags>
      <li>IndustrialBasic</li>
    </apparelTags>
    <weaponMoney>200~400</weaponMoney>
    <weaponTags>
      <li>MedievalMeleeBasic</li>      <!-- Мечи, копья, железные топоры -->
      <li>MedievalRangedBasic</li>     <!-- Арбалеты -->
      <li>AnarchyGun</li>   <!-- Простые пистолеты, дробовики, винтовки -->
    </weaponTags>
    <techHediffsMoney>50~150</techHediffsMoney>
    <techHediffsTags>
      <li>Poor</li>
    </techHediffsTags>
    <inventoryOptions>
      <skipChance>0.9</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>MedicineHerbal</thingDef>
          <countRange>1</countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <initialWillRange>0~1</initialWillRange>
  </PawnKindDef>

  <!-- стрелок -->
  <PawnKindDef ParentName="AnarchistBase">
    <defName>shooter</defName>
    <label>Стрелок</label>
    <combatPower>75</combatPower>
    <itemQuality>Normal</itemQuality>
    <apparelMoney>800~1200</apparelMoney>
    <apparelTags>
      <li>IndustrialBasic</li>
      <li>IndustrialMilitaryAdvanced</li>
    </apparelTags>
    <weaponMoney>600~900</weaponMoney>
    <weaponTags>
      <li>AnarchyGun</li>   <!-- Винтовки, дробовики, пистолеты -->
    </weaponTags>
    <techHediffsMoney>400~800</techHediffsMoney>
    <techHediffsTags>
      <li>Advanced</li>
    </techHediffsTags>
    <inventoryOptions>
      <skipChance>0.8</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>WakeUp</thingDef>
          <countRange>2</countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <initialWillRange>2~5</initialWillRange>
  </PawnKindDef>

  <!-- медик -->
  <PawnKindDef ParentName="AnarchistBase">
    <defName>medic</defName>
    <label>Санитар</label>
    <combatPower>70</combatPower>
