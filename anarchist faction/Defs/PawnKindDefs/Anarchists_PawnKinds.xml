    <techHediffsTags>
      <li>Advanced</li>
    </techHediffsTags>
    <inventoryOptions>
      <skipChance>0</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>MedicineIndustrial</thingDef>
          <countRange>5</countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <initialWillRange>2~5</initialWillRange>
  </PawnKindDef>

