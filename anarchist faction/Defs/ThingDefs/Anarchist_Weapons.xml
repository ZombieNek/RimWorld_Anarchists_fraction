  <!--автоматический пистолет-->
  <ThingDef ParentName="AnarchyGunBase">
    <defName>Anarchy_Gun_Autopistol</defName>
    <label>кустарный автоматический пистолет</label>
    <description>Починеный на коленке пистолет, с наркученным на него глушителем и прицелом. Использовался для скрытных убийств
    и подрывной деятельности. Слабый и не эффективный, зато дешевый</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/Anarchy_Gun_Autopistol</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.5</uiIconScale>
    <soundInteract>Interact_Autopistol</soundInteract>
    <weaponTags Inherit="False">
      <li>AnarchyGun</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedLight</li>
    </weaponClasses>
    <statBases>
      <WorkToMake>5000</WorkToMake>
      <Mass>1.3</Mass>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.40</AccuracyMedium>
      <AccuracyLong>0.30</AccuracyLong>
      <RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_Autopistol</defaultProjectile>
        <warmupTime>0.2</warmupTime>
        <range>25.9</range>
        <soundCast>Shot_Autopistol</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>6</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
  </ThingDef>

