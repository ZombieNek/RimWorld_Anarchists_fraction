<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <!-- Создаем уникальный тег для ванильного пулемета -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Gun_LMG"]/weaponTags</xpath>
        <value>
            <li>Anarchist_LMG_Tag</li>
        </value>
    </Operation>

    <!-- Если хочешь, чтобы пулеметчик мог брать еще и миниган, добавь его сюда же -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Gun_Minigun"]/weaponTags</xpath>
        <value>
            <li>Anarchist_LMG_Tag</li>
        </value>
    </Operation>

    <!-- Уникальный тег для осколочных гранат -->
    <Operation Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Weapon_GrenadeFrag"]/weaponTags</xpath>
      <value>
          <li>Anarchist_Grenade_Tag</li>
      </value>
    </Operation>

<!-- Уникальный тег для коктейлей Молотова -->
    <Operation Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Weapon_GrenadeMolotov"]/weaponTags</xpath>
      <value>
          <li>Anarchist_Grenade_Tag</li>
      </value>
    </Operation>

    <!-- Уникальный тег для снайперской винтовки -->
   <Operation Class="PatchOperationAdd">
       <xpath>Defs/ThingDef[defName="Gun_SniperRifle"]/weaponTags</xpath>
       <value>
           <li>Anarchist_Sniper_Tag</li>
       </value>
   </Operation>

</Patch>
